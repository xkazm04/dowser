{
  "name": "dowser",
  "version": "0.1.0",
  "private": true,
  "description": "Dowser local-scan skill: evidence-backed, fingerprinted backlog proposals from a checked-out repo.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "test": "node --test \"skill/scripts/tests/*.test.mjs\"",
    "forge:typecheck": "npm --prefix forge run typecheck",
    "forge:test": "npm --prefix forge run test",
    "forge:check-shared": "npm --prefix forge run check-shared",
    "forge:build-ui": "npm --prefix forge run build:ui",
    "local:forge": "node tools/local-forge.mjs --http 4710",
    "local:ui": "npm --prefix forge/static/app run dev:local"
  },
  "devDependencies": {
    "@types/node": "~26.6.5",
    "typescript": "~7.0.2"
  }
}
